type Work = 
 record {
   difficultyBits: nat;
   height: nat;
   miningFeeE8s: nat;
   previousHash: blob;
   reward: nat;
 };
type TransferFromError = 
 variant {
   BadBurn: record {min_burn_amount: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientAllowance: record {allowance: nat;};
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type Time = int;
type SweepResult = 
 record {
   burned: nat;
   cyclesFunded: nat;
   cyclesMinted: opt nat;
   notifyError: opt text;
   swept: nat;
 };
type SubmitResult = 
 variant {
   Err: SubmitError;
   Ok: SubmitOk;
 };
type SubmitOk = 
 record {
   hash: blob;
   height: nat;
   reward: nat;
 };
type SubmitError = 
 variant {
   Anonymous;
   IcpFeeFailed: TransferFromError;
   InvalidProof;
   NothingToClaim;
   StaleWork;
   TooSoon: record {retryAfterNanos: nat;};
 };
type Stats = 
 record {
   blocksUntilRetarget: nat;
   cmcId: principal;
   currentReward: nat;
   cyclesFundRatioBps: nat;
   cyclesFundRatioLocked: bool;
   difficultyBits: nat;
   height: nat;
   icpBurnOwner: principal;
   icpFeeTargetLocked: bool;
   icpLedgerId: principal;
   lastRetargetAt: Time;
   ledgerId: principal;
   maxSupply: nat;
   miningFeeE8s: nat;
   nextHalvingHeight: nat;
   retargetIntervalBlocks: nat;
   targetBlockTimeNanos: nat;
   totalIcpBurnedE8s: nat;
   totalMinted: nat;
 };
type PendingNatChange = 
 record {
   readyAt: Time;
   value: nat;
 };
type PendingIcpFeeTarget = 
 record {
   burnOwner: principal;
   cmcId: principal;
   ledgerId: principal;
   readyAt: Time;
 };
type PendingAdminChanges = 
 record {
   cyclesFundRatio: opt PendingNatChange;
   icpFeeTarget: opt PendingIcpFeeTarget;
   timelockNanos: int;
 };
type LeaderboardEntry = 
 record {
   blocksFound: nat;
   miner: principal;
   totalReward: nat;
 };
type Block = 
 record {
   hash: blob;
   height: nat;
   miner: principal;
   reward: nat;
   timestamp: Time;
 };
service : {
  backfillTotalIcpBurned: (amountE8s: nat) -> ();
  cancelPendingCyclesFundRatio: () -> ();
  cancelPendingIcpFeeTarget: () -> ();
  claimPendingReward: () -> (SubmitResult);
  cyclesBalance: () -> (nat) query;
  executeCyclesFundRatioBps: () -> ();
  executeIcpFeeTarget: () -> ();
  getLeaderboard: () -> (vec LeaderboardEntry) query;
  getMinerStats: (p: principal) -> (LeaderboardEntry) query;
  getPendingAdminChanges: () -> (PendingAdminChanges) query;
  getPendingReward: () -> (nat) query;
  getRecentBlocks: () -> (vec Block) query;
  getStats: () -> (Stats) query;
  getTotalPendingRewards: () -> (nat) query;
  getWork: () -> (Work) query;
  lockCyclesFundRatio: () -> ();
  lockIcpFeeTarget: () -> ();
  proposeCyclesFundRatioBps: (bps: nat) -> ();
  proposeIcpFeeTarget: (ledgerId: principal, burnOwner: principal,
   cyclesMintingCanister: principal) -> ();
  pruneStaleAttempts: () -> (nat);
  setMiningFeeE8s: (e8s: nat) -> ();
  submitProof: (nonce: nat) -> (SubmitResult);
  sweepTreasury: () -> (SweepResult);
  topUpProject: () -> (record {
                         toFrontend: nat;
                         toMiner: nat;
                       });
}
